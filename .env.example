# Copy to .env and fill in. Never commit .env.

# Your domain, pointed at this server (A record). Caddy gets the HTTPS certificate itself.
DOMAIN=gifts.example.ie
BASE_URL=https://gifts.example.ie

# 32+ random characters:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# From Google Cloud console (see README, "Google sign-in")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated. These accounts get the admin page and don't need an invite.
ADMIN_EMAILS=you@gmail.com

# Optional: lets the admin enroll someone without Google via a magic sign-in
# link, emailed to them. Leave SMTP_HOST blank to skip email -- the link is
# shown on screen instead, for the admin to send manually.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
